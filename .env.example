# --- Telegram ---
# From @BotFather in Telegram: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your numeric Telegram user id. The bot ignores everyone else.
# Get it by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_ID=000000000

# --- Judge backend ---
# "gemini" (default) or "claude"
LLM_BACKEND=gemini

# Needed when LLM_BACKEND=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Needed only when LLM_BACKEND=claude. Get one at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional ---
# Your name, used in the system prompt ("You are helping <name> decide...").
# USER_NAME=Alex

# Which app the next judge call is for: generic | generic | generic | generic | generic
# DEFAULT_APP=generic

# Where your identity doc lives. Defaults to context.md next to this file.
# CONTEXT_MD_PATH=/home/you/dating-copilot/context.md

# SQLite path. Defaults to dating.db next to this file (falls back to generic.db).
# DB_PATH=/home/you/dating-copilot/dating.db
